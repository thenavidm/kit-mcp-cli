# Place real values in private shell/client settings, never in this repository.
KIT_API_KEY=YOUR_V4_API_KEY
# Or use an OAuth token, with refresh credentials or a private token file.
# KIT_ACCESS_TOKEN=YOUR_OAUTH_ACCESS_TOKEN
# KIT_TOKENS_FILE=/absolute/private/path/kit-tokens.json
KIT_READ_ONLY=0
KIT_ALLOW_DESTRUCTIVE=1
